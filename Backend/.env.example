# =====================================================================
# .env.example — StockIA Backend
# Template de variáveis de ambiente. NUNCA commitar o .env real com valores reais.
# =====================================================================

# =====================================================================
# BANCO DE DADOS
# =====================================================================
PG_USER=postgres
PG_PASS=SENHA_SEGURA_AQUI
PG_DB=stockai

# Dev: SQLite local. Produção: URL do PostgreSQL
DATABASE_URL=sqlite:///./stockai.db
# DATABASE_URL=postgresql://stockia_user:SENHA_SEGURA@localhost:5432/stockia_db

# =====================================================================
# JWT (Autenticação)
# =====================================================================
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GERE_COM_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================================
# CORS
# =====================================================================
# Em produção: substituir por URL real do frontend
ALLOWED_ORIGINS=["http://localhost:3000"]

# =====================================================================
# IA — Circuit Breaker (anti-custo)
# =====================================================================
AI_CALL_LIMIT_PER_WINDOW=50
AI_RATE_WINDOW_SECONDS=3600

# =====================================================================
# GEMINI API (quando integração for implementada)
# =====================================================================
GEMINI_API_KEY=SUA_CHAVE_AQUI
