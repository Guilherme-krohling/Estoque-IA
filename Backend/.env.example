# =====================================================================
# StockIA — Exemplo de variáveis de ambiente
# Copie para .env e ajuste os valores. NÃO commite o .env real.
# =====================================================================

# --- Banco de Dados (PostgreSQL via Docker, ver docker-compose.yml) ---
PG_USER=postgres
PG_PASS=troque-esta-senha
PG_DB=stockai

# URL de conexão usada pela aplicação (porta 5433 mapeada no docker-compose)
DATABASE_URL=postgresql://postgres:troque-esta-senha@127.0.0.1:5433/stockai

# --- JWT / Autenticação ---
# Gere uma chave forte e única (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
# A aplicação NÃO sobe sem esta variável definida.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
